# Copy to .env at the repository root. No secrets are required at this stage.
HOST=0.0.0.0
PORT=4000
# Comma-separated browser origins allowed for HTTP and Socket.IO.
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional absolute path to the local audio directory. Defaults to <repo>/media.
# MEDIA_DIR=/srv/sync/media
# Used by Next.js health, catalog and streaming proxies; never exposed to the browser.
API_INTERNAL_URL=http://127.0.0.1:4000
# Optional public Socket.IO origin. When absent, the browser uses its current
# hostname with port 4000. "/" selects the current browser origin behind a proxy.
# The new web Dockerfile always builds with "/" (one domain, no rebuild on rename).
# NEXT_PUBLIC_SOCKET_URL=https://api.example.com
# Docker Compose published ports (optional).
WEB_PORT=3000
API_PORT=4000
# In-memory room limits and reconnect retention.
MAX_ROOM_PARTICIPANTS=20
MAX_ROOMS=100
RECONNECT_GRACE_MS=30000
EMPTY_ROOM_TTL_MS=300000
# Common start lead in milliseconds, allowed 100-3000.
PLAY_LEAD_MS=750
# Private room uploads; ignored by Git. Defaults to <repo>/.data/uploads.
# UPLOAD_DIR=/srv/sync/uploads
# Limits in bytes: file 20 MiB, room 100 MiB, entire server 512 MiB.
MAX_UPLOAD_BYTES=20971520
MAX_ROOM_UPLOAD_BYTES=104857600
MAX_STORAGE_BYTES=536870912

# SYNC deployment: docker compose -f docker-compose.yml (DEPLOY.md).
# Local mode is private to this machine unless LOCAL_BIND_ADDRESS is changed.
LOCAL_BIND_ADDRESS=127.0.0.1
LOCAL_HTTP_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
# Proxy request limit: 21 MiB (20 MiB audio + multipart overhead).
# If MAX_UPLOAD_BYTES increases, raise this too by at least 1 MiB.
MAX_REQUEST_BYTES=22020096
# Production override requires an owned domain with DNS pointing to the server.
# Hostname only; do not use a URL, port, IP, or wildcard.
# SYNC_DOMAIN=sync.example.com
# ACME_EMAIL=admin@example.com
# Optional tag for locally built web/server images (use a commit SHA for releases).
SYNC_IMAGE_TAG=local
