{
	admin localhost:2019
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_header 10s
			read_body 120s
			idle 2m
		}
	}
}

import /etc/caddy/routes.caddy

{$SYNC_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	import sync_routes
}

http://:8081 {
	handle /health {
		reverse_proxy web:3000 {
			rewrite /api/health
		}
	}
	respond 404
}
